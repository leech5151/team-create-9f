# Supabase — client-side configuration.
#
# These two values are PUBLIC by design. Vite inlines any VITE_* variable into
# the JavaScript bundle, and that bundle is served from GitHub Pages, so anyone
# can read them. They are committed on purpose: keeping them out of the repo
# would only break the Actions build without adding any security.
#
# What actually protects the data is Row Level Security in Postgres:
# anyone may SELECT, only the signed-in admin may write. See
# supabase/schema.sql.
#
# NEVER put the service_role / secret key here — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://ymixizybjozlzcqncsww.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_v-Apb8jzkrEtJproFA6Gnw_zxdODiki
